{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evc.internal/schemas/canonical.v1.json",
  "title": "CanonicalTelemetryEvent",
  "description": "Standardized canonical telemetry event format per NOTE.md §5.1",
  "type": "object",
  "required": [
    "schema_v",
    "vin",
    "ts",
    "seq",
    "oem",
    "lat",
    "lon",
    "geohash7",
    "speed_kmh",
    "soc_pct",
    "odo_km",
    "batt_temp_c",
    "charging",
    "charge_kw",
    "dtc",
    "evt"
  ],
  "properties": {
    "schema_v": {
      "type": "integer",
      "const": 1,
      "description": "Schema version number"
    },
    "vin": {
      "type": "string",
      "pattern": "^[A-HJ-NPR-Z0-9]{17}$",
      "minLength": 17,
      "maxLength": 17,
      "description": "17-character standardized Vehicle Identification Number with position-9 check digit"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO 8601 timestamp (RFC 3339). Must not exceed 5 minutes into the future."
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonically increasing sequence number per VIN"
    },
    "oem": {
      "type": "string",
      "description": "Source OEM identifier (e.g. VoltX, NordMotors, AsiaDrive, EuroEV, ZephyrEV)"
    },
    "lat": {
      "type": "number",
      "minimum": -90.0,
      "maximum": 90.0,
      "description": "Vehicle latitude in decimal degrees"
    },
    "lon": {
      "type": "number",
      "minimum": -180.0,
      "maximum": 180.0,
      "description": "Vehicle longitude in decimal degrees"
    },
    "geohash7": {
      "type": "string",
      "minLength": 7,
      "maxLength": 7,
      "pattern": "^[0-9b-hj-km-np-z]{7}$",
      "description": "7-character geohash resolution (~153m x 153m) derived from lat/lon"
    },
    "speed_kmh": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 250.0,
      "description": "Instantaneous vehicle speed in km/h"
    },
    "soc_pct": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 100.0,
      "description": "Battery State of Charge percentage"
    },
    "odo_km": {
      "type": "number",
      "minimum": 0.0,
      "description": "Cumulative odometer reading in km"
    },
    "batt_temp_c": {
      "type": "number",
      "minimum": -40.0,
      "maximum": 100.0,
      "description": "Battery pack temperature in degrees Celsius"
    },
    "charging": {
      "type": "integer",
      "enum": [0, 1],
      "description": "Charging status flag: 1 if actively charging, 0 if not"
    },
    "charge_kw": {
      "type": "number",
      "minimum": 0.0,
      "description": "Active charging power in kilowatts (kW)"
    },
    "dtc": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[PCBU][0-3][0-9A-F]{3}$"
      },
      "description": "List of active Diagnostic Trouble Codes (SAE J2012 / ISO 15031-6 standard)"
    },
    "evt": {
      "type": "string",
      "enum": ["NONE", "HARSH_BRAKE", "PLUG_IN", "PLUG_OUT", "FAST_CHARGE", "SLOW_CHARGE", "DTC_ALERT"],
      "description": "Discrete telemetry event trigger classification"
    }
  },
  "additionalProperties": false
}
