{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Ingestion & Hot Path Telemetry",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Throughput of normalized telemetry events by OEM",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20, "lineWidth": 2, "spanNulls": false },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      },
      "targets": [
        {
          "expr": "sum(rate(ingest_events_total[30s])) by (oem)",
          "legendFormat": "{{oem}} Ingest Rate",
          "refId": "A"
        },
        {
          "expr": "sum(rate(ingest_events_total[30s]))",
          "legendFormat": "Total Canonical Rate",
          "refId": "B"
        }
      ],
      "title": "Ingest Rate by OEM (ev/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Rate of invalid payloads directed to DLQ and duplicates pruned by Bloom filter",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 25, "lineWidth": 2 },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "sum"] }
      },
      "targets": [
        {
          "expr": "sum(rate(invalid_total[30s])) by (reason)",
          "legendFormat": "DLQ: {{reason}}",
          "refId": "A"
        },
        {
          "expr": "rate(dedupe_dropped_total[30s])",
          "legendFormat": "Bloom Dedupe Dropped",
          "refId": "B"
        }
      ],
      "title": "Invalid & Dedupe Dropped Rate (ev/s)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Storage Sink & Kafka Lag",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "ClickHouse batch flush duration histogram percentiles",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 15, "lineWidth": 2 },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(sink_batch_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 Flush Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(sink_batch_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99 Flush Latency",
          "refId": "B"
        }
      ],
      "title": "Sink Batch Latency (s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Rows persistently inserted into ClickHouse telemetry table",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20, "lineWidth": 2 },
          "unit": "rows/s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "id": 4,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      },
      "targets": [
        {
          "expr": "rate(rows_inserted_total[30s])",
          "legendFormat": "ClickHouse Inserts/sec",
          "refId": "A"
        }
      ],
      "title": "ClickHouse Inserts / sec",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Consumer lag across ingest consumer groups",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20, "lineWidth": 2 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      },
      "targets": [
        {
          "expr": "sum(redpanda_kafka_consumer_group_lag) by (group, topic)",
          "legendFormat": "{{group}} ({{topic}})",
          "refId": "A"
        }
      ],
      "title": "Consumer Lag per Group",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "Real-Time Alerts Engine",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Alert latency from vehicle telemetry event timestamp to alert emission (Target p99 < 5s)",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20, "lineWidth": 2 },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2.0 },
              { "color": "red", "value": 5.0 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(alert_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50 Alert Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(alert_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 Alert Latency",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(alert_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99 Alert Latency",
          "refId": "C"
        }
      ],
      "title": "Alert Latency p50 / p95 / p99 (s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Alerts emitted by type (RANGE_RISK, LOW_SOC, THERMAL, RAPID_DROP, HARSH_BRAKE)",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 25, "lineWidth": 2 },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 7,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "sum"] }
      },
      "targets": [
        {
          "expr": "sum(rate(alerts_emitted_total[1m])) by (type, severity)",
          "legendFormat": "{{type}} [{{severity}}]",
          "refId": "A"
        }
      ],
      "title": "Alerts Emitted Rate by Type",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["motorq", "evc", "telemetry", "alerts"],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["1s", "5s", "10s", "30s", "1m"]
  },
  "timezone": "browser",
  "title": "EV Fleet Telemetry & Alerts Pipeline",
  "uid": "evc-telemetry-pipeline",
  "version": 1
}
